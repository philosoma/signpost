# Generated by the signpost Ansible role. Do not edit on the host.
# Traffic always enters through the login door, never directly to Signpost.
http:
  routers:
    {{ signpost_traefik_router_name }}:
      rule: "Host(`{{ signpost_hostname }}`)"
      entryPoints:
        - websecure
      service: {{ signpost_traefik_router_name }}
      middlewares:
        - "{{ signpost_traefik_mesh_only_middleware }}"
{% if signpost_ratelimit_available %}
        - "{{ signpost_traefik_ratelimit_middleware }}"
{% endif %}
      tls:
        certResolver: {{ signpost_traefik_cert_resolver }}

  services:
    {{ signpost_traefik_router_name }}:
      loadBalancer:
        servers:
          - url: "http://oauth2-proxy-signpost:4180"
