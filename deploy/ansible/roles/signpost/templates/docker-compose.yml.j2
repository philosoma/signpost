# Generated by the signpost Ansible role. Do not edit on the host.
services:
  signpost:
    image: "{{ signpost_image }}"
    platform: "{{ signpost_image_platform }}"
    container_name: signpost
    restart: unless-stopped
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: 128M
    networks:
      - "{{ signpost_traefik_network }}"
    expose:
      - "8080"
    extra_hosts:
{% for host in signpost_pinned_hosts %}
      - "{{ host }}:{{ signpost_core_address }}"
{% endfor %}
    env_file:
      - .env
    volumes:
      - "{{ signpost_compose_dir }}/config.json:/etc/signpost/config.json:ro"
      # Signpost reads the Host names from these to find the node's apps.
      - "{{ signpost_traefik_dynamic_dir }}:{{ signpost_routes_container_dir }}:ro"
    healthcheck:
      test: ["CMD", "/app/signpost", "-healthcheck"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    labels:
      - "traefik.enable=false"

networks:
  "{{ signpost_traefik_network }}":
    external: true
    name: "{{ signpost_traefik_network }}"
